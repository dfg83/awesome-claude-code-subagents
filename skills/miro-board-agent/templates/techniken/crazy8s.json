{
  "name": "Crazy 8s",
  "beschreibung": "8 Ideen in 8 Minuten – schnelle Skizzen für Lösungen",
  "template": {
    "title": "Crazy 8s: {projektName}",
    "description": "8 Ideen in 8 Minuten skizzieren",
    "structure": [
      {
        "type": "text",
        "content": "🎱 CRAZY 8s",
        "style": {"fontSize": 36, "color": "#F24726"},
        "position": {"x": 0, "y": -400}
      },
      {
        "type": "text",
        "content": "Projekt: {projektName}",
        "style": {"fontSize": 20},
        "position": {"x": 0, "y": -350}
      },
      {
        "type": "text",
        "content": "⏱️ Regel: 8 Minuten × 8 Ideen",
        "style": {"fontSize": 16, "color": "#4262FF"},
        "position": {"x": 0, "y": -310}
      }
    ],
    "gridLayout": {
      "rows": 2,
      "columns": 4,
      "cellWidth": 300,
      "cellHeight": 300,
      "startPosition": {"x": -600, "y": -200},
      "cells": [
        {"nummer": 1, "label": "Idee 1"},
        {"nummer": 2, "label": "Idee 2"},
        {"nummer": 3, "label": "Idee 3"},
        {"nummer": 4, "label": "Idee 4"},
        {"nummer": 5, "label": "Idee 5"},
        {"nummer": 6, "label": "Idee 6"},
        {"nummer": 7, "label": "Idee 7"},
        {"nummer": 8, "label": "Idee 8"}
      ]
    }
  },
  "fragen": [
    "Welches Problem oder welche Herausforderung soll gelöst werden?",
    "Für welche Zielgruppe entwickelst du Lösungen?",
    "Gibt es Einschränkungen oder Anforderungen?"
  ]
}
