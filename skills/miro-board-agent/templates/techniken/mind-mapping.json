{
  "name": "Mind Mapping",
  "beschreibung": "Visuelle Organisation von Ideen um ein zentrales Thema",
  "template": {
    "title": "Mind Map: {projektName}",
    "description": "Strukturiere deine Gedanken visuell",
    "structure": [
      {
        "type": "shape",
        "shapeType": "circle",
        "width": 250,
        "height": 250,
        "style": {"fillColor": "#4262FF", "borderColor": "#2E4BC4"},
        "position": {"x": 0, "y": 0}
      },
      {
        "type": "text",
        "content": "🎯 ZENTRALES\nTHEMA",
        "style": {"fontSize": 20, "color": "#FFFFFF", "textAlign": "center"},
        "position": {"x": 0, "y": 0}
      }
    ],
    "layout": "radial",
    "zweige": 8,
    "zweigFarben": ["#F24726", "#F9C523", "#0CA789", "#4262FF", "#7B68EE", "#FF6B9D", "#00CED1", "#FF8C42"]
  },
  "fragen": [
    "Was ist das zentrale Thema oder Problem?",
    "Welche Hauptkategorien/Kategorien fallen dir ein?",
    "Wie tief soll die Struktur gehen?"
  ]
}
