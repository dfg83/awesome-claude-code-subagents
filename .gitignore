# Ignore everything by default
*

# But allow this .gitignore file itself
!.gitignore

# And allow the projects folder and its contents
!projects/
!projects/*
!projects/**/*

# Skills remain ignored - if a skill is project-specific, keep it in projects/
# The skills/ folder is for shared/reusable skills only

# Still ignore internal files even inside projects
projects/.openclaw/
projects/.pi/
projects/.git/

# Ignore these file types anywhere
*.log
.DS_Store
node_modules/
