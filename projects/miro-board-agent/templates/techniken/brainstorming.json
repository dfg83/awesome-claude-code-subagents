{
  "name": "Brainstorming",
  "beschreibung": "Freies Sammeln von Ideen ohne Bewertung",
  "template": {
    "title": "Brainstorming: {projektName}",
    "description": "Sammle alle Ideen – keine ist zu verrückt!",
    "structure": [
      {
        "type": "text",
        "content": "🧠 BRAINSTORMING",
        "style": {"fontSize": 36, "color": "#4262FF"},
        "position": {"x": 0, "y": -200}
      },
      {
        "type": "text",
        "content": "Projekt: {projektName}",
        "style": {"fontSize": 24},
        "position": {"x": 0, "y": -150}
      },
      {
        "type": "text",
        "content": "🎯 Thema/Fragestellung:",
        "style": {"fontSize": 20, "color": "#F24726"},
        "position": {"x": -400, "y": -80}
      },
      {
        "type": "shape",
        "shapeType": "rectangle",
        "width": 800,
        "height": 100,
        "style": {"fillColor": "#FFF9B1", "borderColor": "#F24726"},
        "position": {"x": 0, "y": 0}
      },
      {
        "type": "text",
        "content": "💡 Ideen-Sammlung:",
        "style": {"fontSize": 18, "color": "#0CA789"},
        "position": {"x": -400, "y": 80}
      }
    ],
    "arbeitspaketeZonen": [
      {
        "name": "ideen",
        "label": "Ideen",
        "startPosition": {"x": -350, "y": 150},
        "stickyColor": "light_yellow",
        "maxColumns": 4,
        "columnWidth": 200,
        "rowHeight": 150
      }
    ]
  },
  "fragen": [
    "Was ist die zentrale Fragestellung oder das Problem?",
    "Soll es Zeitbegrenzungen geben?",
    "Wer moderiert das Brainstorming?"
  ]
}
